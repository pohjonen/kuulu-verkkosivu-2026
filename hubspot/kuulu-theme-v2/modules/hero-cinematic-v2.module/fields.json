      {
        "name": "eyebrow",
        "label": "Eyebrow",
        "type": "text",
        "default": ""
      },
      {
        "name": "heading",
        "label": "Pääotsikko",
        "type": "text",
        "default": "Kukaan ei klikkaa. Ja kauppa käy."
      },
      {
        "name": "highlight_phrase",
        "label": "Korostusosa",
        "type": "text",
        "default": ""
      },
      {
        "name": "lead_text",
        "label": "Ingressi",
        "type": "textarea",
        "default": "Vanha klikkiajattelu ei enää riitä. Brändi, sisältö ja kysynnän kotiutus pitää rakentaa samaan koneistoon."
